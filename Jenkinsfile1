pipeline {

    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven-3.9.16'
        nodejs 'NodeJS-24'
    }

    environment {
        DEPLOY_DIR = 'C:\\Deployments\\Naukri'

        AZURE_STORAGE_ACCOUNT = 'naukribuildartifacts'
        BACKEND_CONTAINER = 'backend-artifacts'
        FRONTEND_CONTAINER = 'frontend-artifacts'
    }

    stages {

        // ==========================================================
        // 1. CHECKOUT
        // ==========================================================

        stage('Checkout') {
            steps {

                git branch: 'main',
                    url: 'https://github.com/Swetha98867/team-zanskar-Naukri.git'
            }
        }


        // ==========================================================
        // 2. BUILD & TEST
        // ==========================================================

        stage('Build & Test') {
            steps {

                echo '===================================='
                echo 'BACKEND BUILD'
                echo '===================================='

                dir('backend') {
                    bat 'mvn clean verify'
                }


                echo '===================================='
                echo 'BACKEND TEST'
                echo '===================================='

                dir('backend') {
                    bat 'mvn test'
                }


                echo '===================================='
                echo 'FRONTEND BUILD'
                echo '===================================='

                dir('frontend') {
                    bat 'npm install'
                    bat 'npm run build'
                }


                echo '===================================='
                echo 'VERIFY BUILD ARTIFACTS'
                echo '===================================='

                bat '''
                if not exist "backend\\target\\naukri-be.jar" (
                    echo ERROR: Backend JAR not found!
                    exit /b 1
                )

                if not exist "frontend\\dist\\index.html" (
                    echo ERROR: Frontend build not found!
                    exit /b 1
                )

                echo Backend JAR and Frontend artifacts are available.
                '''
            }
        }


        // ==========================================================
        // 3. ELECTRON PACKAGE PREPARATION
        // ==========================================================

        stage('Electron Package Preparation') {
            steps {

                echo '===================================='
                echo 'COPY FRONTEND TO ELECTRON'
                echo '===================================='

                bat '''
                if exist "electron\\renderer" (
                    rmdir /S /Q "electron\\renderer"
                )

                xcopy "frontend\\dist" "electron\\renderer" /E /I /Y

                if errorlevel 1 (
                    echo ERROR: Failed to copy frontend to Electron.
                    exit /b 1
                )
                '''


                echo '===================================='
                echo 'INSTALL ELECTRON DEPENDENCIES'
                echo '===================================='

                dir('electron') {
                    bat 'npm install'
                }


                echo '===================================='
                echo 'PREPARE BUNDLED JRE'
                echo '===================================='

                bat '''
                if not exist "C:\\Tools\\Naukri\\jre\\bin\\java.exe" (
                    echo ERROR: Bundled JRE not found!
                    echo Expected:
                    echo C:\\Tools\\Naukri\\jre\\bin\\java.exe
                    exit /b 1
                )

                if not exist "electron\\resources\\jre" (
                    mkdir "electron\\resources\\jre"
                )

                xcopy "C:\\Tools\\Naukri\\jre\\*" ^
                      "electron\\resources\\jre\\" ^
                      /E /I /Y

                if errorlevel 1 (
                    echo ERROR: Failed to copy bundled JRE.
                    exit /b 1
                )

                echo Bundled JRE copied successfully.
                '''


                echo '===================================='
                echo 'VERIFY ELECTRON RESOURCES'
                echo '===================================='

                bat '''
                if not exist "electron\\resources\\jre\\bin\\java.exe" (
                    echo ERROR: Electron JRE missing!
                    exit /b 1
                )

                if not exist "backend\\target\\naukri-be.jar" (
                    echo ERROR: Backend JAR missing!
                    exit /b 1
                )

                echo Electron resources verified successfully.
                '''
            }
        }


        // ==========================================================
        // 4. SONARQUBE + QUALITY GATE
        // ==========================================================

        stage('SonarQube + Quality Gate') {
            steps {

                echo '===================================='
                echo 'SONARQUBE ANALYSIS'
                echo '===================================='

                withSonarQubeEnv('SonarQube') {

                    dir('backend') {

                        bat '''
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=Naukri ^
                        -Dsonar.projectName=Naukri ^
                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }


                echo '===================================='
                echo 'WAITING FOR QUALITY GATE'
                echo '===================================='

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate abortPipeline: true
                }

                echo '===================================='
                echo 'QUALITY GATE PASSED'
                echo '===================================='
            }
        }


        // ==========================================================
        // 5. PACKAGE & ARCHIVE
        // ==========================================================

        stage('Package & Archive') {
            steps {

                echo '===================================='
                echo 'BUILDING ELECTRON APPLICATION'
                echo '===================================='

                dir('electron') {

                    bat 'npm run dist'
                }


                echo '===================================='
                echo 'ARCHIVING JENKINS ARTIFACTS'
                echo '===================================='

                archiveArtifacts(
                    artifacts: 'backend/target/*.jar,dist/**/*.exe,dist/**/*.zip',
                    fingerprint: true
                )

                echo 'Artifacts archived successfully.'
            }
        }


        // ==========================================================
        // 6. UPLOAD ARTIFACTS TO AZURE STORAGE
        // ==========================================================

        stage('Upload Artifacts to Azure Storage') {
            steps {

                echo '===================================='
                echo 'AZURE LOGIN'
                echo '===================================='

                bat '''
                az login --identity

                if errorlevel 1 (
                    echo ERROR: Azure Managed Identity login failed.
                    exit /b 1
                )

                echo Azure login successful.
                '''


                echo '===================================='
                echo 'UPLOAD BACKEND ARTIFACT'
                echo '===================================='

                bat '''
                az storage blob upload ^
                    --account-name %AZURE_STORAGE_ACCOUNT% ^
                    --container-name %BACKEND_CONTAINER% ^
                    --name naukri-be.jar ^
                    --file "backend\\target\\naukri-be.jar" ^
                    --auth-mode login ^
                    --overwrite true

                if errorlevel 1 (
                    echo ERROR: Backend upload failed.
                    exit /b 1
                )

                echo Backend artifact uploaded successfully.
                '''


                echo '===================================='
                echo 'UPLOAD FRONTEND ARTIFACTS'
                echo '===================================='

                bat '''
                az storage blob upload-batch ^
                    --account-name %AZURE_STORAGE_ACCOUNT% ^
                    --destination %FRONTEND_CONTAINER% ^
                    --source "frontend\\dist" ^
                    --auth-mode login ^
                    --overwrite

                if errorlevel 1 (
                    echo ERROR: Frontend upload failed.
                    exit /b 1
                )

                echo Frontend artifacts uploaded successfully.
                '''
            }
        }
                stage('Deploy') {
            steps {

                echo '===================================='
                echo 'LOCAL DEPLOYMENT'
                echo '===================================='

                bat '''
                if not exist "%DEPLOY_DIR%" (
                    mkdir "%DEPLOY_DIR%"
                )

                echo Checking generated Electron artifacts...

                if not exist "dist\\NaukriAutomator 0.1.0.exe" (
                    echo ERROR: Electron EXE not found in dist!
                    exit /b 1
                )

                if not exist "dist\\NaukriAutomator Setup 0.1.0.exe" (
                    echo ERROR: Electron installer not found in dist!
                    exit /b 1
                )

                echo Electron artifacts found successfully.

                echo Stopping old Naukri application...

                taskkill /F /IM "NaukriAutomator 0.1.0.exe" >NUL 2>&1
                taskkill /F /IM "NaukriAutomator.exe" >NUL 2>&1

                timeout /T 2 /NOBREAK >NUL

                echo Removing old deployment...

                del /F /Q "%DEPLOY_DIR%\\NaukriAutomator 0.1.0.exe" >NUL 2>&1
                del /F /Q "%DEPLOY_DIR%\\NaukriAutomator Setup 0.1.0.exe" >NUL 2>&1
                del /F /Q "%DEPLOY_DIR%\\naukri-be.jar" >NUL 2>&1

                echo Copying backend...

                copy /Y "backend\\target\\naukri-be.jar" "%DEPLOY_DIR%\\naukri-be.jar"

                if errorlevel 1 (
                    echo ERROR: Backend deployment failed.
                    exit /b 1
                )

                echo Copying Electron portable EXE...

                copy /Y "dist\\NaukriAutomator 0.1.0.exe" "%DEPLOY_DIR%\\NaukriAutomator 0.1.0.exe"

                if errorlevel 1 (
                    echo ERROR: Electron EXE deployment failed.
                    exit /b 1
                )

                echo Copying Electron installer...

                copy /Y "dist\\NaukriAutomator Setup 0.1.0.exe" "%DEPLOY_DIR%\\NaukriAutomator Setup 0.1.0.exe"

                if errorlevel 1 (
                    echo ERROR: Electron installer deployment failed.
                    exit /b 1
                )

                echo Verifying deployment...

                if not exist "%DEPLOY_DIR%\\naukri-be.jar" (
                    echo ERROR: Backend JAR missing.
                    exit /b 1
                )

                if not exist "%DEPLOY_DIR%\\NaukriAutomator 0.1.0.exe" (
                    echo ERROR: Electron EXE missing.
                    exit /b 1
                )

                if not exist "%DEPLOY_DIR%\\NaukriAutomator Setup 0.1.0.exe" (
                    echo ERROR: Installer missing.
                    exit /b 1
                )

                echo.
                echo ====================================
                echo DEPLOYED FILES
                echo ====================================

                dir "%DEPLOY_DIR%"

                echo.
                echo ====================================
                echo DEPLOYMENT SUCCESSFUL
                echo ====================================
                '''
            }
        }
    }

    post {

        success {
            echo '''
            ==========================================
            NAUKRI CI/CD PIPELINE SUCCESSFUL
            ==========================================
            '''
        }

        failure {
            echo '''
            ==========================================
            NAUKRI CI/CD PIPELINE FAILED
            ==========================================
            '''
        }

        always {
            cleanWs()
        }
    }
}


       
